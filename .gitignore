# KiCad .gitignore - ignore backups, caches and generated outputs

# Editor / OS
*~
**/*.swp
**/*.tmp
**/*.bak
**/*.orig
**/*.rej
.DS_Store
Thumbs.db

# KiCad backups / autosaves
**/*.kicad_pcb-bak
**/*.kicad_pcb-bck
**/*.kicad_sch-bak
**/*.kicad_sch-bck
**/*.sch~
**/*.kicad_sch~
**/*.autosave

# KiCad cache / library local files (can be regenerated)
**/fp-cache/
**/fp-info-cache
**/fp-lib-table
**/sym-lib-table
**/sym_cache/
**/cache/

# 3D models and exported CAD files
**/*.3dshapes/
**/*.wrl
**/*.step
**/*.stp
**/*.stl
**/*.iges

# Fabrication / generated outputs
gerbers/
fab/
plots/
export/
pnp/
mfg/
**/*.gbr
**/*.drl
**/*.drls
**/*.pos
**/*.zip

# C files
**/*.o
**/*.elf
**/*.bin
**/*build


**/*.DS_Store%