(version 1)

(rule TMDS_HDMI_IN_A
	(condition "A.hasNetClass('TMDS') && A.NetName == '/HDMI_Switch/HDMI_IN_A/*'")
	(constraint length (min 202.5ps) (opt 203ps) (max 203.5ps))
)

(rule TMDS_HDMI_IN_B
	(condition "A.hasNetClass('TMDS') && A.NetName == '/HDMI_Switch/HDMI_IN_B/*'")
	(constraint length (min 170.3ps) (opt 170.8ps) (max 171.3ps))
)

(rule TMDS_HDMI_OUT
	(condition "A.hasNetClass('TMDS') && A.NetName == '/HDMI_Switch/HDMI_OUT/*'")
	(constraint length (min 134.8ps) (opt 135.3ps) (max 135.8ps))
)


(rule "TMDS copper pour clearance"
    (condition "A.NetClass == 'TMDS' && B.Type == 'zone' && B.Name != 'TMDS_GND_EXEMPT'")
    (constraint clearance (min 0.5mm))
)

(rule "TMDS copper pour clearance"
    (condition "A.NetClass == 'TMDS' && B.Type == 'zone' && B.Name == 'TMDS_GND_EXEMPT'")
    (constraint clearance (min 0.15mm))
)


(rule "USB copper pour clearance"
    (condition "A.NetClass == 'USB' && B.Type == 'zone' && B.Name != 'USB_GND_EXEMPT'")
    (constraint clearance (min 0.5mm))
)

(rule "USB copper pour clearance"
    (condition "A.NetClass == 'USB' && B.Type == 'zone' && B.Name == 'USB_GND_EXEMPT'")
    (constraint clearance (min 0.2mm))
)
